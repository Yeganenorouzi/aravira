# پورت سرور
PORT=4000

# کلید امضای توکن‌ها (در محیط عملیاتی حتماً مقدار تصادفی و محرمانه بگذارید)
JWT_SECRET=

# رمز اولیه‌ی حساب مدیر (فقط هنگام ساخت داده‌ی اولیه استفاده می‌شود)
ADMIN_PASSWORD=admin123

# محیط اجرا: development | production
NODE_ENV=development

# لایسنس ماژول‌ها (اختیاری)
# اگر مقدار بدهید، بر تنظیمات پنل اولویت دارد و از پنل قابل تغییر نیست.
LICENSE=

# کلید عمومی لایسنس (اختیاری)
# به‌صورت پیش‌فرض از فایل server/license-public.pem خوانده می‌شود.
LICENSE_PUBLIC_KEY=
